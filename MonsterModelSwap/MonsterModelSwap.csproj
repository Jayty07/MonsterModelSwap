<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.5.0.0</Version>
    <Description>Swap the local player's model to any monster/NPC ModelChara and keep it applied across zoning and cutscenes.</Description>
    <PackageProjectUrl>https://github.com/Jayty07/MonsterModelSwap</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Dalamud dev assemblies. Defaults to the XIVLauncher dev hooks folder; override with -p:DalamudLibPath=... -->
  <PropertyGroup Condition="'$(DalamudLibPath)' == '' and '$(DALAMUD_HOME)' != ''">
    <DalamudLibPath>$(DALAMUD_HOME)/</DalamudLibPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Data\models.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
